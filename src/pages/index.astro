---
import BaseLayout from '../layouts/BaseLayout.astro'
import Navbar from '../components/Navbar/Navbar'
import Header from '../components/Header/Header'
import About from '../components/About/About'
import Skills from '../components/Skills/Skills'
import Projects from '../components/Projects/Projects'
import Contact from '../components/Contact/Contact'
import Footer from '../components/Footer/Footer'
import CursorTrail from '../components/UX/CursorTrail'
---

<BaseLayout path="/">
	<div class="App bg-skin-bg min-h-screen transition-colors duration-300">
		<Navbar client:load />
		<Header client:load />
		<About client:visible />
		<Skills client:visible />
		<Projects client:visible />
		<Contact client:visible />
		<Footer client:visible />
		<CursorTrail client:idle color="rgba(255, 196, 102, 0.55)" />
	</div>
</BaseLayout>
